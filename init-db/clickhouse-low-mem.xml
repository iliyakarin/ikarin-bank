<clickhouse>
    <!-- Disable heavy internal profiling log tables that consume GBs of disk and I/O in demo mode -->
    <asynchronous_metric_log remove="1"/>
    <metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <part_log remove="1"/>
    <query_thread_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_log>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
    </query_log>

    <!-- Cap ClickHouse server memory and caches for demo workload -->
    <max_server_memory_usage>536870912</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>33554432</uncompressed_cache_size>

    <!-- Reduce background thread pools (from ~325 threads down to ~40) -->
    <max_thread_pool_size>200</max_thread_pool_size>
    <max_connections>128</max_connections>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_pool_size>4</background_pool_size>
    <background_fetches_pool_size>2</background_fetches_pool_size>
    <background_common_pool_size>2</background_common_pool_size>
    <background_buffer_flush_schedule_pool_size>2</background_buffer_flush_schedule_pool_size>
    <background_message_broker_schedule_pool_size>2</background_message_broker_schedule_pool_size>
</clickhouse>
